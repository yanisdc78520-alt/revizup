# Copie ce fichier en .env.local pour lancer l'app sur ton ordinateur,
# ou colle chaque ligne dans Vercel > Settings > Environment Variables.
# Ne mets JAMAIS ces valeurs dans le code ni dans un message.

# Adresse publique du site (sans / à la fin)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé secrète "service_role" : uniquement côté serveur
SUPABASE_SERVICE_ROLE_KEY=

# --- Modèle d'IA open source (tout serveur compatible "OpenAI chat completions") ---
# Scaleway Generative APIs : https://api.scaleway.ai/v1 (vérifie l'adresse dans ta console Scaleway)
# OVHcloud AI Endpoints, vLLM ou Ollama sur ton propre serveur : mets leur adresse .../v1
LLM_BASE_URL=https://api.scaleway.ai/v1
LLM_API_KEY=
# Modèle pour les fiches et les quiz (le plus capable disponible)
LLM_MODEL=llama-3.3-70b-instruct
# Modèle rapide pour repérer les thèmes d'un cours (facultatif, sinon LLM_MODEL)
LLM_MODEL_FAST=mistral-nemo-instruct-2407
# Taille maximale de cours envoyée au modèle par demande, en caractères
LLM_MAX_INPUT_CHARS=60000
# Mettre false si ton serveur refuse l'option response_format
LLM_JSON_MODE=true

# --- Stripe (Developers > API keys), en mode test pour commencer ---
STRIPE_SECRET_KEY=sk_test_...
# Identifiant du prix de l'abonnement Pro (Product catalog > RevizUp Pro > price_...)
STRIPE_PRICE_ID=price_...
# Secret du webhook (Developers > Webhooks > ton endpoint > Signing secret)
STRIPE_WEBHOOK_SECRET=whsec_...
